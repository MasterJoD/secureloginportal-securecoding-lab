# Copy these values into your shell or IDE environment. The app does not auto-load this file.
SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=0
DATABASE_PATH=instance/students.db
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Optional SMTP configuration for password reset emails
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-app-password
MAIL_USE_TLS=1
MAIL_DEFAULT_SENDER=SecurePortal <no-reply@example.com>
